# E2E Test Configuration
# Copy this file to .env.test and fill in your values

# Headscale Server Configuration
TEST_HEADSCALE_URL=http://localhost:8080
TEST_PREAUTH_KEY=your-preauth-key-here

# Test Device Configuration (optional, for device connectivity tests)
TEST_DEVICE_MESH_IP=100.64.0.2
TEST_DEVICE_LAN_IP=192.168.1.100
TEST_DEVICE_SSH_PORT=22

# Test Timeouts (milliseconds)
TEST_REGISTRATION_TIMEOUT=30000
TEST_CONNECTION_TIMEOUT=15000

# Test Mode
# - real: Use real Headscale server
# - mock: Use mocked responses (for CI/CD)
TEST_MODE=real
